---
export type Props = {
  title: string;
  subtitle: string;
  locationText: string;
};

const { title, subtitle, locationText } = Astro.props;
---

<header class="pt-10 pb-6">
  <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
    <div class="relative">
      <div class="h-24 w-24 rounded-full bg-white shadow-soft ring-1 ring-black/5" />
      <div class="absolute inset-0 rounded-full ring-2 ring-rosewood/40" />
      <div class="absolute inset-[10px] rounded-full bg-gradient-to-br from-blush to-white" />
    </div>

    <h1 class="mt-5 font-serif text-4xl font-bold tracking-tight text-charcoal">
      {title}
    </h1>
    <p class="mt-1 text-sm font-medium text-charcoal/70">{subtitle}</p>

    <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-charcoal shadow-soft ring-1 ring-black/5">
      <span aria-hidden="true">📍</span>
      <span>{locationText}</span>
    </div>
  </div>
</header>
