---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Lash Brows | Panel de Control';

const error = Astro.url.searchParams.get('error');
const debugU = Astro.url.searchParams.get('u') ?? '';
const debugEU = Astro.url.searchParams.get('eu') ?? '';
const debugPL = Astro.url.searchParams.get('pl') ?? '';
const debugEPL = Astro.url.searchParams.get('epl') ?? '';
const errorMessage =
  error === 'invalid'
    ? 'Usuario o contraseña incorrectos.'
    : error === 'config'
      ? 'Falta configurar las credenciales del administrador.'
      : error === 'forbidden'
        ? 'No tienes permisos para acceder a este panel.'
      : error === 'session'
        ? 'Tu sesión no pudo validarse. Intenta iniciar sesión de nuevo.'
      : '';
---

<BaseLayout title={title}>
  <main
    class="min-h-[100dvh] w-full grid place-items-center bg-gradient-to-b from-[#efe7e2] via-[#f7f1ed] to-[#e9dfd8] p-4 sm:p-6"
    style="min-height: 100dvh; display: grid; place-items: center;"
  >
    <section
      aria-label="Acceso al panel de control"
      class="w-full max-w-md mx-auto"
    >
      <div
        class="relative aspect-square overflow-hidden rounded-3xl bg-[#f3ece7] ring-1 ring-black/10 shadow-[0_30px_70px_-40px_rgba(0,0,0,0.45)]"
      >
        <div class="absolute inset-0 bg-gradient-to-b from-white/85 via-white/40 to-white/15 pointer-events-none" aria-hidden="true"></div>

        <div
          class="relative flex h-full flex-col justify-center px-7 py-9 sm:px-9 sm:py-10"
          style="height: 100%; display: flex; flex-direction: column; justify-content: center;"
        >
          <div class="mx-auto w-full max-w-sm">
            <header class="text-center">
              <p class="text-xs font-semibold tracking-[0.32em] text-rosewood">ADMIN</p>
              <h1 class="relative mt-1.5 inline-block font-serif text-3xl font-semibold tracking-tight text-charcoal sm:text-4xl">
                Lash Brows
                <span
                  aria-hidden="true"
                  class="absolute left-1/2 -bottom-1 h-2 w-[88%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#c9a36a] to-transparent opacity-80 blur-[1px]"
                ></span>
              </h1>
              <p class="mt-2 text-sm font-semibold text-charcoal/65">Panel de Control</p>
            </header>

            <form method="post" action="/api/admin/login" enctype="application/x-www-form-urlencoded" class="mt-7 space-y-4" novalidate>
              {errorMessage ? (
                <p class="rounded-2xl bg-white/70 px-4 py-3 text-center text-xs font-semibold text-rosewood ring-1 ring-black/10">
                  {errorMessage}
                </p>
              ) : null}

              {error === 'invalid' && (debugU || debugEU || debugPL || debugEPL) ? (
                <p class="rounded-2xl bg-white/60 px-4 py-3 text-[10px] font-semibold leading-snug text-charcoal/70 ring-1 ring-black/10">
                  u: {debugU || '-'} | eu: {debugEU || '-'} | pl: {debugPL || '-'} | epl: {debugEPL || '-'}
                </p>
              ) : null}

            <div>
              <label for="email" class="block text-sm font-semibold text-charcoal">Email</label>
              <div class="mt-1.5 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 ring-1 ring-black/10">
                <span class="text-rosewood" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21a8 8 0 0 0-16 0" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                </span>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="username"
                  placeholder="correo@ejemplo.com"
                  required
                  class="w-full bg-transparent text-sm font-medium text-charcoal outline-none placeholder:text-charcoal/40"
                />
              </div>
            </div>

            <div>
              <label for="password" class="block text-sm font-semibold text-charcoal">Contraseña</label>
              <div class="mt-1.5 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 ring-1 ring-black/10">
                <span class="text-rosewood" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 11V8a5 5 0 0 1 10 0v3" />
                    <path d="M6 11h12v10H6z" />
                  </svg>
                </span>
                <input
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  placeholder="••••••••"
                  required
                  class="w-full bg-transparent text-sm font-medium text-charcoal outline-none placeholder:text-charcoal/40"
                />
                <button type="button" aria-label="Mostrar contraseña" class="text-charcoal/50">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3l18 18" />
                    <path d="M10.6 6.1A10.7 10.7 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-3.2 3.9" />
                    <path d="M6.4 7.4A17 17 0 0 0 2 12s3.5 6 10 6a10.7 10.7 0 0 0 4.6-1" />
                    <path d="M9.9 9.9A3 3 0 0 0 14.1 14.1" />
                  </svg>
                </button>
              </div>
              <div class="mt-1.5 text-right">
                <a href="/admin/forgot" class="text-[11px] font-semibold text-rosewood underline underline-offset-4">
                  He olvidado mi contraseña
                </a>
              </div>
            </div>

            <button
              type="submit"
              class="mt-1 inline-flex w-full items-center justify-center rounded-full bg-rosewood px-6 py-3 text-sm font-semibold text-white shadow-[0_18px_35px_-22px_rgba(178,58,98,0.85)] ring-1 ring-black/10"
            >
              Iniciar Sesión
            </button>

            <p class="text-center font-medium leading-snug text-charcoal/55" style="font-size: 10px;">
              Acceso restringido. Si no tienes credenciales, contacta a la administración.
            </p>
          </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
