---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Lash Brows | Recuperar contraseña';

const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
const errorMessage =
  error === 'forbidden'
    ? 'Este correo no tiene permiso para recuperar acceso.'
    : error === 'invalid'
      ? 'Ingresa un correo válido.'
      : error === 'server'
        ? 'Ocurrió un error. Intenta de nuevo.'
        : '';
---

<BaseLayout title={title}>
  <main
    class="min-h-[100dvh] w-full grid place-items-center bg-gradient-to-b from-[#efe7e2] via-[#f7f1ed] to-[#e9dfd8] p-4 sm:p-6"
    style="min-height: 100dvh; display: grid; place-items: center;"
  >
    <section aria-label="Recuperar contraseña" class="w-full max-w-md mx-auto">
      <div class="relative aspect-square overflow-hidden rounded-3xl bg-[#f3ece7] ring-1 ring-black/10 shadow-[0_30px_70px_-40px_rgba(0,0,0,0.45)]">
        <div class="absolute inset-0 bg-gradient-to-b from-white/85 via-white/40 to-white/15 pointer-events-none" aria-hidden="true"></div>

        <div
          class="relative flex h-full flex-col justify-center px-7 py-9 sm:px-9 sm:py-10"
          style="height: 100%; display: flex; flex-direction: column; justify-content: center;"
        >
          <div class="mx-auto w-full max-w-sm">
            <header class="text-center">
              <p class="text-xs font-semibold tracking-[0.32em] text-rosewood">ADMIN</p>
              <h1 class="relative mt-1.5 inline-block font-serif text-3xl font-semibold tracking-tight text-charcoal sm:text-4xl">
                Lash Brows
                <span
                  aria-hidden="true"
                  class="absolute left-1/2 -bottom-1 h-2 w-[88%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#c9a36a] to-transparent opacity-80 blur-[1px]"
                ></span>
              </h1>
              <p class="mt-2 text-sm font-semibold text-charcoal/65">Recuperar contraseña</p>
            </header>

            {errorMessage ? (
              <p class="mt-7 rounded-2xl bg-white/70 px-4 py-3 text-center text-xs font-semibold text-rosewood ring-1 ring-black/10">
                {errorMessage}
              </p>
            ) : null}

            {ok ? (
              <p class="mt-7 rounded-2xl bg-white/70 px-4 py-3 text-center text-xs font-semibold text-charcoal ring-1 ring-black/10">
                Si el correo es correcto, te llegará un enlace para restablecer tu contraseña.
              </p>
            ) : null}

            <form id="forgot-form" class="mt-7 space-y-4" novalidate>
              <div>
                <label for="email" class="block text-sm font-semibold text-charcoal">Email</label>
                <div class="mt-1.5 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 ring-1 ring-black/10">
                  <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    placeholder="correo@ejemplo.com"
                    required
                    class="w-full bg-transparent text-sm font-medium text-charcoal outline-none placeholder:text-charcoal/40"
                  />
                </div>
              </div>

              <button
                type="submit"
                class="mt-1 inline-flex w-full items-center justify-center rounded-full bg-rosewood px-6 py-3 text-sm font-semibold text-white shadow-[0_18px_35px_-22px_rgba(178,58,98,0.85)] ring-1 ring-black/10"
              >
                Enviar enlace
              </button>

              <p id="status" class="text-center font-medium leading-snug text-charcoal/55" style="font-size: 10px;"></p>

              <div class="text-center">
                <a href="/admin" class="text-[11px] font-semibold text-rosewood underline underline-offset-4">
                  Volver a iniciar sesión
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('forgot-form');
    const status = document.getElementById('status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Enviando...';

      const email = document.getElementById('email').value;
      if (!email) {
        window.location.href = '/admin/forgot?error=invalid';
        return;
      }

      try {
        const res = await fetch('/api/admin/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        if (res.status === 403) {
          window.location.href = '/admin/forgot?error=forbidden';
          return;
        }

        if (!res.ok) {
          window.location.href = '/admin/forgot?error=server';
          return;
        }

        window.location.href = '/admin/forgot?ok=1';
      } catch {
        window.location.href = '/admin/forgot?error=server';
      }
    });
  </script>
</BaseLayout>
