---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSupabaseServerClient } from '../lib/supabaseServer';

const year = new Date().getFullYear();

function formatMxPrice(input: string) {
  const raw = String(input ?? '').trim();
  if (!raw) return '';
  const cleaned = raw.replace(/\s*mxn\s*$/i, '').trim();
  const noDollar = cleaned.replace(/^\$/, '').trim();
  return `$${noDollar} MXN`;
}

const fallbackServices = [
  {
    title: 'Pestañas Clásicas',
    description:
      'Una extensión por pestaña natural. Acabado discreto y elegante para el día a día.',
    price: '',
    image:
      'https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?auto=format&fit=crop&w=1600&q=70',
    alt: 'Pestañas Clásicas',
  },
  {
    title: 'Volumen Ruso',
    description:
      'Abanicos hechos a mano para una mirada con más densidad, definición y profundidad.',
    price: '',
    image:
      'https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?auto=format&fit=crop&w=1600&q=70',
    alt: 'Volumen Ruso',
  },
  {
    title: 'Diseño de Cejas',
    description:
      'Perfilado, depilación y diseño personalizado según la forma de tu rostro.',
    price: '',
    image:
      'https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?auto=format&fit=crop&w=1600&q=70',
    alt: 'Diseño de Cejas',
  },
];

let testimonials = [];

let services = [];
const fallbackHero = {
  address: 'P. Usumacinta, multi 80',
  title: 'Resalta tu belleza natural.',
  subtitle: 'Especialistas en extensiones de pestañas y diseño de mirada en el corazón de la ciudad.',
};

let hero = fallbackHero;

const fallbackPromo = {
  title: 'Efecto Mojado',
  description:
    'Extensiones con un acabado brillante y moderno para un look sofisticado y en tendencia.',
  price: '$499',
  image: '/gallery/efecto-mojado.jpg',
  alt: 'Promo del mes - Efecto Mojado',
};

let promo = fallbackPromo;
let gallery = [
  { src: '/gallery/trabajo-de-pestañas-1.jpg', alt: 'Trabajo 1' },
  { src: '/gallery/trabajo-de-pestañas-2.jpg', alt: 'Trabajo 2' },
  { src: '/gallery/trabajo-de-pestañas-3.jpg', alt: 'Trabajo 3' },
];

try {
  const supabase = getSupabaseServerClient();
  const { data: heroData, error: heroError } = await supabase
    .from('hero_settings')
    .select('*')
    .eq('id', 1)
    .single();

  if (!heroError && heroData) {
    hero = {
      address: heroData.address ?? fallbackHero.address,
      title: heroData.title ?? fallbackHero.title,
      subtitle: heroData.subtitle ?? fallbackHero.subtitle,
    };
  }

  const { data, error } = await supabase
    .from('services')
    .select('*')
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: true });

  if (error) throw error;
  services = (data ?? []).map((row) => ({
    title: row.title ?? '',
    description: row.description ?? '',
    price: row.price ?? '',
    image:
      row.image_url ??
      'https://images.unsplash.com/photo-1527799820374-dcf8d9d4a388?auto=format&fit=crop&w=1600&q=70',
    alt: row.image_alt ?? row.title ?? 'Servicio',
  }));
} catch {
  services = fallbackServices;
}

const shownServices = services.slice(0, 10);

try {
  const supabase = getSupabaseServerClient();
  const { data, error } = await supabase.from('promo_settings').select('*').eq('id', 1).single();
  if (!error && data) {
    promo = {
      title: data.title ?? fallbackPromo.title,
      description: data.description ?? fallbackPromo.description,
      price: data.price ?? fallbackPromo.price,
      image: data.image_url ?? fallbackPromo.image,
      alt: data.image_alt ?? fallbackPromo.alt,
    };
  }
} catch {
  // keep fallback promo
}

try {
  const supabase = getSupabaseServerClient();
  const { data, error } = await supabase
    .from('work_photos')
    .select('*')
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: true })
    .limit(60);

  if (!error && data && data.length) {
    gallery = data.map((row, idx) => ({
      src: row.image_url,
      alt: row.alt ?? `Trabajo ${idx + 1}`,
    }));
  }
} catch {
  // keep fallback gallery
}

const whatsappHref = 'https://wa.me/529932833607';
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(hero.address)}`;
const instagramHref =
  'https://www.instagram.com/lashbrowss_?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==';
const tiktokHref = 'https://www.tiktok.com/@lashbrowss_';

const fallbackTestimonials = [
  {
    name: 'Mariana López',
    quote:
      'Me encantó el resultado. Se ven súper naturales y el acabado es muy limpio. ¡Volveré seguro!',
    stars: 5,
  },
  {
    name: 'Valeria Méndez',
    quote:
      'La atención es excelente y el diseño de mirada quedó perfecto para mi rostro. 10/10.',
    stars: 5,
  },
  {
    name: 'Fernanda Ruiz',
    quote:
      'Me explicaron todo el proceso, súper higiénico y cómodo. Mis pestañas quedaron hermosas.',
    stars: 5,
  },
];

try {
  const supabase = getSupabaseServerClient();
  const { data, error } = await supabase
    .from('testimonials')
    .select('*')
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: true })
    .limit(14);

  if (error) throw error;
  testimonials = (data ?? []).map((row) => ({
    name: row.name ?? '',
    quote: row.quote ?? '',
    stars: Number.isFinite(row.stars) ? Number(row.stars) : 5,
  }));
} catch {
  testimonials = fallbackTestimonials;
}

const faqs = [
  {
    q: '¿Cuánto dura el servicio?',
    a: 'Depende del diseño y tu cuidado. En general, las extensiones se recomiendan con retoque cada 2–3 semanas.',
  },
  {
    q: '¿Necesito cita previa?',
    a: 'Sí. Trabajamos por agenda para darte el tiempo y detalle que tu servicio necesita.',
  },
  {
    q: '¿Qué cuidados debo tener?',
    a: 'Evita frotar los ojos, usa productos suaves y sigue nuestras recomendaciones de limpieza para mayor duración.',
  },
  {
    q: '¿Dónde se ubican?',
    a: '📍 P. Usumacinta, multi 80. Puedes abrir la ubicación desde el botón de mapa en la página.',
  },
  {
    q: '¿Puedo agendar por WhatsApp?',
    a: 'Sí. Usa el botón “Agendar Cita” y te respondemos para confirmar tu horario.',
  },
];
---

<BaseLayout title="Lash Brows | Extensiones de Pestañas">
  <header class="sticky top-0 z-50 border-b border-white/10 bg-rosewood/90 backdrop-blur">
    <div class="max-w-7xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="#inicio" class="font-serif text-2xl font-semibold tracking-tight text-white">
        Lash Brows
      </a>

      <div class="flex items-center gap-3">
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-white/85">
          <a href="#servicios" class="transition hover:text-white">Servicios</a>
          <a href="#promo" class="transition hover:text-white">Promo</a>
          <a href="#trabajo" class="transition hover:text-white">Nuestro trabajo</a>
          <a href="#contacto" class="transition hover:text-white">Contacto</a>
        </nav>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-white px-4 py-2 text-sm font-semibold text-rosewood shadow-soft ring-1 ring-white/20 transition hover:bg-white/90 active:scale-[0.99]"
        >
          Agendar Cita
        </a>
      </div>
    </div>
  </header>

  <main>
    <section id="inicio" class="relative">
      <div class="min-h-[80vh] bg-gradient-to-b from-white via-blush/40 to-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="min-h-[80vh] flex flex-col justify-center items-center text-center px-0 py-20">
            <div class="max-w-3xl">
              <div class="inline-flex items-center gap-2 rounded-full bg-white/80 px-4 py-2 text-xs font-semibold text-charcoal shadow-soft ring-1 ring-black/5">
                <span aria-hidden="true">📍</span>
                <a href={mapsHref} target="_blank" rel="noreferrer" class="hover:underline">
                  {hero.address}
                </a>
              </div>

              <h1 class="mt-8 font-serif text-5xl font-bold tracking-tight text-charcoal sm:text-6xl lg:text-7xl">
                {hero.title}
              </h1>
              <p class="mt-6 text-base font-medium text-charcoal/70 sm:text-lg">
                {hero.subtitle}
              </p>

              <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex w-full items-center justify-center rounded-full bg-rosewood px-7 py-4 text-base font-semibold text-white shadow-soft ring-1 ring-black/5 transition hover:opacity-95 active:scale-[0.99] sm:w-auto"
                >
                  Reserva tu espacio
                </a>
                <a
                  href="#trabajo"
                  class="inline-flex w-full items-center justify-center rounded-full bg-white px-7 py-4 text-base font-semibold text-charcoal shadow-soft ring-1 ring-black/5 transition hover:bg-white/90 active:scale-[0.99] sm:w-auto"
                >
                  Ver nuestro trabajo
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="servicios" class="py-16 sm:py-24">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-center font-serif text-4xl font-semibold tracking-tight text-charcoal">
          Nuestros Servicios
        </h2>
        <p class="mt-4 mx-auto max-w-2xl text-center text-sm font-medium text-charcoal/60 sm:text-base">
          Técnicas actuales, acabados delicados y resultados que elevan tu mirada con un estilo limpio y lujoso.
        </p>

        {shownServices.length <= 3 ? (
          <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
            {shownServices.map((service) => (
              <article class="group relative overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-rosewood/15 transition hover:ring-rosewood/25">
                <div class="relative">
                  <img
                    src={service.image}
                    alt={service.alt}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full object-cover"
                  />
                  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-rosewood/15 via-transparent to-transparent opacity-90" />
                </div>

                <div class="p-6">
                  <div aria-hidden="true" class="mb-4 h-px w-20 bg-gradient-to-r from-rosewood/60 to-transparent" />
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-serif text-2xl font-semibold text-charcoal">
                      {service.title}
                    </h3>
                    {service.price ? (
                      <span class="text-sm font-semibold text-rosewood">{formatMxPrice(service.price)}</span>
                    ) : null}
                  </div>
                  <p class="mt-3 text-sm font-medium leading-relaxed text-charcoal/70">
                    {service.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="mt-12 relative">
            <button
              type="button"
              aria-label="Anterior"
              class="services-prev absolute left-0 top-1/2 z-10 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full bg-rosewood/90 text-white shadow-soft ring-1 ring-black/10 hover:bg-rosewood"
            >
              <span class="block text-lg leading-none">‹</span>
            </button>
            <button
              type="button"
              aria-label="Siguiente"
              class="services-next absolute right-0 top-1/2 z-10 -translate-y-1/2 flex h-11 w-11 items-center justify-center rounded-full bg-rosewood/90 text-white shadow-soft ring-1 ring-black/10 hover:bg-rosewood"
            >
              <span class="block text-lg leading-none">›</span>
            </button>

            <div class="services-carousel flex gap-6 overflow-x-auto scroll-smooth px-10 pb-2 snap-x snap-mandatory [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {shownServices.map((service) => (
                <article class="group relative w-[280px] flex-none snap-start overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-rosewood/15 transition hover:ring-rosewood/25">
                  <div class="relative">
                    <img
                      src={service.image}
                      alt={service.alt}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover"
                    />
                    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-rosewood/15 via-transparent to-transparent opacity-90" />
                  </div>

                  <div class="p-6">
                    <div aria-hidden="true" class="mb-4 h-px w-20 bg-gradient-to-r from-rosewood/60 to-transparent" />
                    <div class="flex items-baseline justify-between gap-3">
                      <h3 class="font-serif text-2xl font-semibold text-charcoal">
                        {service.title}
                      </h3>
                      {service.price ? (
                        <span class="text-sm font-semibold text-rosewood">{formatMxPrice(service.price)}</span>
                      ) : null}
                    </div>
                    <p class="mt-3 text-sm font-medium leading-relaxed text-charcoal/70">
                      {service.description}
                    </p>
                  </div>
                </article>
              ))}
            </div>

            <script is:inline>
              (function () {
                const root = document.currentScript?.closest('section');
                if (!root) return;
                const track = root.querySelector('.services-carousel');
                const prev = root.querySelector('.services-prev');
                const next = root.querySelector('.services-next');
                if (!track || !prev || !next) return;

                function step(dir) {
                  const first = track.querySelector('article');
                  const cardWidth = first ? first.getBoundingClientRect().width : 280;
                  const gap = 24;
                  track.scrollBy({ left: dir * (cardWidth + gap), behavior: 'smooth' });
                }

                prev.addEventListener('click', () => step(-1));
                next.addEventListener('click', () => step(1));
              })();
            </script>
          </div>
        )}
      </div>
    </section>

    <section id="promo" class="bg-rose-50">
      <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2">
          <div>
            <p class="text-sm font-semibold tracking-[0.25em] text-rosewood">
              PROMO DEL MES
            </p>
            <h2 class="mt-4 font-serif text-4xl font-semibold tracking-tight text-charcoal sm:text-5xl">
              {promo.title}
            </h2>
            <p class="mt-4 text-sm font-medium text-charcoal/70 sm:text-base">
              {promo.description}
            </p>
            <div class="mt-8 inline-flex items-baseline gap-3 rounded-3xl bg-white px-6 py-4 shadow-soft ring-1 ring-black/5">
              <span class="text-sm font-semibold tracking-wide text-charcoal/60">Desde</span>
              <span class="font-serif text-4xl font-bold text-rosewood">{promo.price}</span>
            </div>
            <div class="mt-8">
              <a
                href={whatsappHref}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full bg-rosewood px-7 py-4 text-base font-semibold text-white shadow-soft ring-1 ring-black/5 transition hover:opacity-95 active:scale-[0.99]"
              >
                Agendar ahora
              </a>
            </div>
          </div>

          <div class="overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-black/5">
            <img
              src={promo.image}
              alt={promo.alt}
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="trabajo" class="py-16 sm:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 class="font-serif text-4xl font-semibold tracking-tight text-charcoal">
              Nuestro Trabajo
            </h2>
            <p class="mt-3 max-w-2xl text-sm font-medium text-charcoal/60 sm:text-base">
              Una selección de estilos, texturas y acabados pensados para resaltar lo mejor de tu rostro.
            </p>
          </div>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-charcoal shadow-soft ring-1 ring-black/5 transition hover:bg-white/90 active:scale-[0.99]"
          >
            Cotiza por WhatsApp
          </a>
        </div>

        <div class="mt-12 columns-2 gap-4 md:columns-3">
          {gallery.map((img) => (
            <div class="mb-4 break-inside-avoid overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-black/5">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="w-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="referencias" class="py-16 sm:py-24 bg-gradient-to-b from-white via-blush/20 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h2 class="font-serif text-4xl font-semibold tracking-tight text-charcoal">
            Opiniones
          </h2>
          <p class="mt-3 mx-auto max-w-2xl text-sm font-medium text-charcoal/60 sm:text-base">
            Referencias reales de clientes felices con su nueva mirada.
          </p>
        </div>

        {testimonials.length <= 3 ? (
          <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
            {testimonials.map((t) => (
              <article class="rounded-3xl bg-white p-7 shadow-soft ring-1 ring-black/5">
                <div class="text-sm font-semibold text-rosewood">{'★'.repeat(Math.max(1, Math.min(5, Number(t.stars) || 5)))}</div>
                <p class="mt-4 text-sm font-medium leading-relaxed text-charcoal/75">
                  “{t.quote}”
                </p>
                <p class="mt-5 text-sm font-semibold text-charcoal">{t.name}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="mt-12 overflow-hidden">
            <div class="testimonials-carousel flex gap-6 overflow-x-auto scroll-smooth pb-2 snap-x snap-mandatory [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {[...testimonials, ...testimonials].map((t) => (
                <article class="w-[320px] flex-none snap-start rounded-3xl bg-white p-7 shadow-soft ring-1 ring-black/5">
                  <div class="text-sm font-semibold text-rosewood">{'★'.repeat(Math.max(1, Math.min(5, Number(t.stars) || 5)))}</div>
                  <p class="mt-4 text-sm font-medium leading-relaxed text-charcoal/75">
                    “{t.quote}”
                  </p>
                  <p class="mt-5 text-sm font-semibold text-charcoal">{t.name}</p>
                </article>
              ))}
            </div>

            <script is:inline>
              (function () {
                const root = document.currentScript?.closest('section');
                if (!root) return;
                const track = root.querySelector('.testimonials-carousel');
                if (!track) return;

                let timer;
                function normalize() {
                  const half = track.scrollWidth / 2;
                  if (track.scrollLeft >= half) {
                    track.scrollLeft = track.scrollLeft - half;
                  }
                }

                function step() {
                  const first = track.querySelector('article');
                  const cardWidth = first ? first.getBoundingClientRect().width : 320;
                  const gap = 24;
                  track.scrollBy({ left: cardWidth + gap, behavior: 'smooth' });
                }

                function start() {
                  stop();
                  timer = setInterval(step, 3500);
                }

                function stop() {
                  if (timer) clearInterval(timer);
                  timer = null;
                }

                track.addEventListener('scroll', () => {
                  normalize();
                });

                track.addEventListener('mouseenter', stop);
                track.addEventListener('mouseleave', start);
                start();
              })();
            </script>
          </div>
        )}
      </div>
    </section>

    <section id="faq" class="py-16 sm:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h2 class="font-serif text-4xl font-semibold tracking-tight text-charcoal">
            Preguntas Frecuentes
          </h2>
          <p class="mt-3 mx-auto max-w-2xl text-sm font-medium text-charcoal/60 sm:text-base">
            Respuestas rápidas para que llegues con total confianza a tu cita.
          </p>
        </div>

        <div class="mt-12 mx-auto max-w-5xl divide-y divide-black/5 rounded-3xl bg-white shadow-soft ring-1 ring-black/5">
          {faqs.map((item) => (
            <details class="group px-6 py-5">
              <summary class="cursor-pointer list-none text-sm font-semibold text-charcoal outline-none">
                <span class="flex items-center justify-between gap-6">
                  <span>{item.q}</span>
                  <span class="text-rosewood transition group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3 text-sm font-medium leading-relaxed text-charcoal/70">
                {item.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <footer id="contacto" class="bg-neutral-900 text-white">
      <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
          <div class="md:col-span-5">
            <h3 class="font-serif text-3xl font-semibold">Lash Brows</h3>
            <p class="mt-4 text-sm font-medium text-white/70">
              Belleza y estilo con un enfoque premium: atención al detalle, higiene y resultados que se sienten elegantes.
            </p>
          </div>

          <div class="md:col-span-4">
            <h4 class="text-sm font-semibold tracking-wide text-white/80">Contacto</h4>
            <div class="mt-4 space-y-3 text-sm font-medium">
              <p class="text-white/70">📍 P. Usumacinta, multi 80</p>
              <a href={whatsappHref} target="_blank" rel="noreferrer" class="block text-white/70 hover:text-white">
                WhatsApp: 993 283 3607
              </a>
            </div>
          </div>

          <div class="md:col-span-3">
            <h4 class="text-sm font-semibold tracking-wide text-white/80">Redes</h4>
            <div class="mt-4 space-y-3 text-sm font-medium">
              <a href={instagramHref} target="_blank" rel="noreferrer" class="block text-white/70 hover:text-white">Instagram</a>
